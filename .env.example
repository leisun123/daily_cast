# Application configuration file. Environment variables override YAML values.
DAILYCAST_CONFIG_PATH=config/app.example.yaml

# Non-Docker local development defaults. Docker Compose overrides the host to 0.0.0.0.
DAILYCAST_APP__SERVER__HOST=127.0.0.1
DAILYCAST_APP__SERVER__PORT=8000

# Durable task deadline checked at pipeline checkpoint boundaries.
DAILYCAST_TASK_EXECUTION__DEADLINE_SECONDS=1800

# Runtime storage roots. DATA_DIR remains private; PUBLIC_DIR is only exposed by explicit deployment configuration.
DATA_DIR=data
PUBLIC_DIR=public

# Direct LLM credential. Select openai_compatible (Chat Completions) or
# openai_responses (Responses/Codex) in YAML or with DAILYCAST_LLM__PROVIDER.
# Keep all credential values out of YAML and version control.
DAILYCAST_LLM__PROVIDER=openai_compatible
DAILYCAST_LLM__API_KEY=

# Alpha records content-quality findings but permits structurally valid output.
# Set true to restore the strict review-verdict and validation gate.
DAILYCAST_EDITORIAL__ENFORCE_QUALITY_GATE=false

# Draft-audio provider settings. Edge TTS does not require an API key.
DAILYCAST_TTS__PROVIDER=edge_tts
DAILYCAST_TTS__VOICE=zh-CN-XiaoxiaoNeural
DAILYCAST_TTS__SPEED=1.0
# edge-tts does not accept caller SSML; enhanced_text adds safe plain-text pauses.
DAILYCAST_TTS__TEXT_MODE=enhanced_text
DAILYCAST_TTS__PRONUNCIATION_DICTIONARY_PATH=config/pronunciation.yaml
DAILYCAST_TTS__OPENING_SUMMARY_SPEED=0.94
DAILYCAST_TTS__CLOSING_SUMMARY_SPEED=0.94
DAILYCAST_TTS__TIMEOUT_SECONDS=30
DAILYCAST_TTS__MAX_RETRIES=2
DAILYCAST_TTS__CACHE_ENABLED=true
DAILYCAST_FFMPEG__SAMPLE_RATE=24000
DAILYCAST_FFMPEG__BITRATE=64k

# Public RSS/media origin. This does not expose the management API by itself.
DAILYCAST_PUBLISHING__AUTO_PUBLISH=true
DAILYCAST_PUBLISHING__PUBLIC_BASE_URL=http://127.0.0.1:8000
DAILYCAST_PUBLISHING__FEED_TITLE=DailyCast
DAILYCAST_PUBLISHING__FEED_DESCRIPTION=A personal AI news podcast.
DAILYCAST_PUBLISHING__LANGUAGE=zh-CN
DAILYCAST_PUBLISHING__AUTHOR=DailyCast

# Docker Compose host-only settings. These select the host port and volume paths;
# they are distinct from DATA_DIR and PUBLIC_DIR inside the application.
DAILYCAST_HOST_ADDRESS=127.0.0.1
DAILYCAST_HOST_PORT=8000
DAILYCAST_DATA_DIR=./data
DAILYCAST_PUBLIC_DIR=./public
DAILYCAST_UID=1000
DAILYCAST_GID=1000
