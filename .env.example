# Application configuration file. Environment variables override YAML values.
# DAILYCAST_CONFIG_PATH may also point to a custom YAML, e.g. config/app.yaml with the briefing section enabled.
DAILYCAST_CONFIG_PATH=config/app.example.yaml

# Non-Docker local development defaults. Docker Compose overrides the host to 0.0.0.0.
DAILYCAST_APP__SERVER__HOST=127.0.0.1
DAILYCAST_APP__SERVER__PORT=8000
# Set true only when an unauthenticated deployment should expose diagnostics,
# feed.xml, and immutable media while hiding all operator routes.
DAILYCAST_APP__PUBLIC_ONLY=false
# Optional public manual trigger. Set a 32+ character random value only as a Zeabur
# password variable; never commit it. It protects POST /api/v1/manual/generate.
# DAILYCAST_APP__MANUAL_TRIGGER_TOKEN=replace-with-a-long-random-secret

# Durable task deadline checked at pipeline checkpoint boundaries.
DAILYCAST_TASK_EXECUTION__DEADLINE_SECONDS=1800

# Runtime storage roots. DATA_DIR remains private; PUBLIC_DIR is only exposed by explicit deployment configuration.
DATA_DIR=data
PUBLIC_DIR=public

# Preferred OpenAI Responses model. Keep credential values out of YAML and Git.
DAILYCAST_LLM__PROVIDER=openai_responses
DAILYCAST_LLM__BASE_URL=https://api.openai.com/v1
DAILYCAST_LLM__MODEL=gpt-5.6-terra
DAILYCAST_LLM__API_KEY=
# Provider-level failures fall back once to this OpenAI-compatible DeepSeek endpoint.
DAILYCAST_LLM__FALLBACK__PROVIDER=openai_compatible
DAILYCAST_LLM__FALLBACK__BASE_URL=https://api.deepseek.com
DAILYCAST_LLM__FALLBACK__MODEL=deepseek-chat
DAILYCAST_LLM__FALLBACK__API_KEY=

# Alpha records content-quality findings but permits structurally valid output.
# Set true to restore the strict review-verdict and validation gate.
DAILYCAST_EDITORIAL__ENFORCE_QUALITY_GATE=false

# Draft-audio provider settings. Edge TTS does not require an API key.
DAILYCAST_TTS__PROVIDER=edge_tts
DAILYCAST_TTS__VOICE=zh-CN-XiaoxiaoNeural
DAILYCAST_TTS__SPEED=1.0
# edge-tts does not accept caller SSML; enhanced_text adds safe plain-text pauses.
DAILYCAST_TTS__TEXT_MODE=enhanced_text
DAILYCAST_TTS__PRONUNCIATION_DICTIONARY_PATH=config/pronunciation.yaml
DAILYCAST_TTS__OPENING_SUMMARY_SPEED=0.94
DAILYCAST_TTS__CLOSING_SUMMARY_SPEED=0.94
DAILYCAST_TTS__TIMEOUT_SECONDS=30
DAILYCAST_TTS__MAX_RETRIES=2
DAILYCAST_TTS__CACHE_ENABLED=true
DAILYCAST_FFMPEG__SAMPLE_RATE=24000
DAILYCAST_FFMPEG__BITRATE=64k

# Public RSS/media origin. This does not expose the management API by itself.
DAILYCAST_PUBLISHING__AUTO_PUBLISH=true
DAILYCAST_PUBLISHING__PUBLIC_BASE_URL=http://127.0.0.1:8000
DAILYCAST_PUBLISHING__FEED_TITLE=DailyCast
DAILYCAST_PUBLISHING__FEED_DESCRIPTION=A personal AI news podcast.
DAILYCAST_PUBLISHING__LANGUAGE=zh-CN
DAILYCAST_PUBLISHING__AUTHOR=DailyCast
# Keep RSS enabled: its immutable public media asset is the input to external targets.
DAILYCAST_PUBLISHING__RSS__ENABLED=true
# NetEase uses a persistent Playwright browser profile below DATA_DIR. Log in manually;
# never put username, password, cookies, or browser profile files in this repository.
DAILYCAST_PUBLISHING__NETEASE__ENABLED=false
DAILYCAST_PUBLISHING__NETEASE__PROFILE_DIR=netease/profile
DAILYCAST_PUBLISHING__NETEASE__HEADLESS=true
DAILYCAST_PUBLISHING__NETEASE__CREATOR_URL=https://music.163.com/creatorcenter
# DAILYCAST_PUBLISHING__NETEASE__COVER_PATH=/absolute/path/to/podcast-cover.png
DAILYCAST_PUBLISHING__NETEASE__CATEGORY=资讯
# Xiaoyuzhou remains disabled until a supported distribution flow is configured.
DAILYCAST_PUBLISHING__XIAOYUZHOU__ENABLED=false

# Docker Compose host-only settings. These select the host port and volume paths;
# they are distinct from DATA_DIR and PUBLIC_DIR inside the application.
DAILYCAST_HOST_ADDRESS=127.0.0.1
DAILYCAST_HOST_PORT=8000
DAILYCAST_DATA_DIR=./data
DAILYCAST_PUBLIC_DIR=./public
DAILYCAST_UID=1000
DAILYCAST_GID=1000

# Optional daily briefing webhook (required when briefing.webhook_enabled=true)
DAILYCAST_BRIEFING__WEBHOOK_URL=
# Payload contract: wecom_markdown (default) or generic_json
DAILYCAST_BRIEFING__WEBHOOK_FORMAT=
# Optional RSSHub deployment for `rsshub://` briefing sources. The base URL is
# the instance root; the access key (RSSHub ACCESS_KEY) is appended to every
# resolved route and stays in the environment, never in the source seeds.
DAILYCAST_BRIEFING__RSSHUB_BASE_URL=
DAILYCAST_BRIEFING__RSSHUB_ACCESS_KEY=
