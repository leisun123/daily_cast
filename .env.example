# Only deployment-specific values and secrets belong here. Tune non-secret
# behavior in config/app.example.yaml instead of duplicating it as environment variables.
DAILYCAST_CONFIG_PATH=config/app.example.yaml

# Override this only when using a compatible proxy or gateway.
DAILYCAST_LLM__BASE_URL=https://api.openai.com/v1
# Keep the credential out of YAML and version control.
DAILYCAST_LLM__API_KEY=
